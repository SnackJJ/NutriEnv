# nutri-env chat keys. Copy to .env / .env.local (both gitignored) and fill.
# load order: .env first, then .env.local; the first file that sets a key wins.

# --- DashScope (qwen/glm/kimi/DeepSeek-snapshot ids in EXPANDER_MODELS) ---
DASHSCOPE_API_KEY=

# --- DeepSeek direct (fallback heuristic for unknown ids) ---
DEEPSEEK_API_KEY=

# --- opencode-go gateway (any model catalog the operator owns) ---
# Set both to enable the opencode route for any unlisted model id you pass
# via scripts/generate_one_cli.py --model <any opencode model id>.
# The model id is sent verbatim to this OpenAI-compatible endpoint.
OPENCODE_BASE_URL=
OPENCODE_API_KEY=
