# nutri-env chat keys. Copy to .env / .env.local (both gitignored) and fill.
# load order: .env first, then .env.local; the first file that sets a key wins.

# --- DashScope (qwen/glm/kimi/DeepSeek-snapshot ids in EXPANDER_MODELS) ---
DASHSCOPE_API_KEY=

# --- DeepSeek direct (fallback heuristic for unknown ids) ---
DEEPSEEK_API_KEY=

# --- opencode-go gateway (any model catalog the operator owns) ---
# FULL chat-completions URL (base + /chat/completions). E.g.:
#   https://opencode.ai/zen/go/v1/chat/completions
# Set both to enable the opencode route for any unlisted model id (the
# ids `opencode models` shows WITHOUT the `opencode-go/` prefix, e.g.
# minimax-m3, deepseek-v4-flash, grok-4.5). The id is sent verbatim.
OPENCODE_BASE_URL=
OPENCODE_API_KEY=
